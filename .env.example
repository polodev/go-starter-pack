# Copy to .env and fill in; .env is git-ignored. Lines starting with # are off: uncomment and fill them when needed.
# (An empty NAME= line would override a built-in default with nothing, so blank ones stay commented.)
APP_NAME="Go Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3200

JWT_SECRET=

# AI_PROVIDER=

# OPENAI_API_KEY=
# OPENAI_BASE_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_starter
# Tests use their own database and refuse any name that does not end in _test.
DB_TEST_DATABASE=go_starter_test
DB_USERNAME=root
# DB_PASSWORD=

# GRPC_HOST=
# GRPC_PORT=

# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

# Queue: database (Laravel's jobs table; `go run .` also runs a worker, production runs `queue:work`) or sync.
QUEUE_CONNECTION=database

# Files: "local" (storage/app) or "r2_public" (Cloudflare R2 public bucket) for facades.Storage() without Disk().
FILESYSTEM_DISK=local

# Cloudflare R2. Public bucket: uploads anyone may read (R2_PUBLIC_URL is its r2.dev or custom domain address).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_URL=https://pub-<id>.r2.dev
R2_ROOT=go-starter-pack

# Database backups (backup:run) go to a private bucket with its own keys, never the public one.
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_BUCKET=
BACKUP_NAME=go-starter-pack
BACKUP_PREFIX=db-backups
# Where the compressed dump waits before upload; default storage/app/backup-temp.
# BACKUP_TEMPORARY_DIRECTORY=
# Who is mailed when a backup fails or backup:monitor finds the backups unhealthy (else only the log).
# BACKUP_NOTIFICATION_EMAIL=ops@example.com
# backup:clean keeps (Spatie's defaults): all for 7 days, then one a day for 16 days, a week for 8 weeks,
# a month for 4 months, a year for 2 years; then deletes the oldest above the size limit. The newest always stays.
# BACKUP_KEEP_ALL_BACKUPS_FOR_DAYS=7
# BACKUP_KEEP_DAILY_BACKUPS_FOR_DAYS=16
# BACKUP_KEEP_WEEKLY_BACKUPS_FOR_WEEKS=8
# BACKUP_KEEP_MONTHLY_BACKUPS_FOR_MONTHS=4
# BACKUP_KEEP_YEARLY_BACKUPS_FOR_YEARS=2
# BACKUP_DELETE_OLDEST_WHEN_USING_MORE_MEGABYTES_THAN=5000
# backup:monitor is unhealthy when the newest backup is older or the backups use more space than this.
# BACKUP_MAXIMUM_AGE_IN_DAYS=1
# BACKUP_MAXIMUM_STORAGE_IN_MEGABYTES=5000

# ANTHROPIC_BASE_URL=

# GEMINI_BASE_URL=

# Mail (Goravel's mail; queued through the database queue). Locally run a catcher such as Mailpit
# (MAIL_HOST=127.0.0.1, MAIL_PORT=1025, inbox on http://localhost:8025). MAIL_MAILER=ses sends through Amazon SES
# with the IAM keys below (the SMTP password is derived from the secret key).
MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="Go Starter"
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
# AWS_SES_DEFAULT_REGION=ap-southeast-1

# Roles: these user ids pass every permission check (a way back in; keep empty normally).
# ROLE_PERMISSION_SUPER_USER_IDS=

# Media library: local (this server) or r2 (public files in R2_PUBLIC_BUCKET, private ones in R2_PRIVATE_BUCKET).
MEDIA_STORAGE=local
MEDIA_PREFIX=media
# R2_PRIVATE_BUCKET=

# Activity log and AI API logs are cleaned daily after this many days.
# ACTIVITY_LOG_RETENTION_DAYS=365
# AI_LOG_RETENTION_DAYS=90

# AI service (Goravel's AI SDK). AI_PROVIDER: anthropic, openai or gemini. Prices (USD per million tokens) are only
# for the cost estimate in the AI API logs; without them the cost stays empty.
AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AI_LOG_CONTENT=true
# AI_PRICES={"claude-sonnet-5-5": {"input": 3, "output": 15}}

# PDF: headless Chrome. Set the path when Chrome is not in the usual place.
# PDF_CHROME_PATH=/usr/bin/chromium

# Security headers (app/http/middleware.SecurityHeaders). The policy allows scripts from this site only; empty sends none.
# SECURITY_CONTENT_SECURITY_POLICY=
# HSTS (https only, one year) is on when APP_ENV=production. Turn it on only when the site is served over https.
# SECURITY_STRICT_TRANSPORT_SECURITY=true
# SECURITY_STRICT_TRANSPORT_SECURITY_MAX_AGE=31536000
