{{ define "admin::roles-tabs" }}
<nav class="mb-5 flex flex-wrap gap-1 border-b border-slate-200 text-sm dark:border-slate-800" data-testid="roles-tabs">
  {{ $tab := .tab }}
  {{ range $item := list "overview|Overview|/admin/role-permissions" "roles|Roles|/admin/role-permissions/roles" "permissions|Permissions|/admin/role-permissions/permissions" "matrix|Permission matrix|/admin/role-permissions/matrix" "users|User assignments|/admin/role-permissions/users" "links|Backend links|/admin/role-permissions/links" }}
    {{ $parts := split $item "|" }}
    <a href="{{ index $parts 2 }}" class="-mb-px border-b-2 px-3 py-2 {{ if eq (index $parts 0) $tab }}border-brand-amber font-semibold{{ else }}border-transparent hover:text-brand-amber{{ end }}">{{ index $parts 1 }}</a>
  {{ end }}
</nav>{{ end }}

{{ define "admin::roles-overview" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
<div class="grid gap-4 sm:grid-cols-4">
  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500">Roles</p><p class="text-3xl font-bold" data-testid="role-count">{{ .roleCount }}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500">Permissions</p><p class="text-3xl font-bold" data-testid="permission-count">{{ .permissionCount }}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500">People with a role</p><p class="text-3xl font-bold">{{ .assigned }}</p></div>
  <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"><p class="text-sm text-slate-500">Direct exceptions</p><p class="text-3xl font-bold">{{ .exceptions }}</p></div>
</div>
<p class="mt-5 text-sm text-slate-600 dark:text-slate-400">Roles and permissions are defined in code (<code>app-modules/role-permission/definitions.go</code>). After a change, sync them. People get their role on Users › Edit.</p>
{{ if .unmapped }}<p class="mt-3 text-sm text-brand-coral" data-testid="unmapped-warning">{{ len .unmapped }} admin route(s) have no permission and answer 403 to everyone. See Backend links.</p>{{ end }}
{{ if call .can "roles.sync" }}
<form method="post" action="/admin/role-permissions/sync" class="mt-5"><input type="hidden" name="_token" value="{{ .csrf }}">
  <button class="rounded bg-brand-navy px-4 py-2 text-white" data-testid="sync-button">Sync roles and permissions</button></form>
{{ end }}
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::roles-index" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
{{ template "admin::card-start" . }}<table class="w-full text-left">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">Rank</th><th class="px-4 py-2">Role</th><th class="px-4 py-2">Description</th><th class="px-4 py-2">Permissions</th></tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">{{ $counts := .counts }}
  {{ range .roles }}<tr data-testid="role-row"><td class="px-4 py-2">{{ .Rank }}</td><td class="px-4 py-2"><a href="/admin/role-permissions/roles/{{ .Slug }}" class="underline">{{ .Name }}</a> <code class="text-xs text-slate-500">{{ .Slug }}</code></td><td class="px-4 py-2">{{ if .Description }}{{ .Description }}{{ end }}</td><td class="px-4 py-2">{{ index $counts .Slug }}</td></tr>{{ end }}
  </tbody></table>{{ template "admin::card-end" . }}
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::role-show" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
<p class="mb-4 text-slate-600 dark:text-slate-400">{{ if .role.Description }}{{ .role.Description }}{{ end }}</p>
<h2 class="mb-2 font-semibold">Permissions</h2>
<div class="mb-6 flex flex-wrap gap-1" data-testid="role-permissions">{{ range .permissions }}<span class="rounded bg-slate-100 px-2 py-0.5 text-sm dark:bg-slate-800">{{ .Key }}</span>{{ end }}</div>
<h2 class="mb-2 font-semibold">People with this role</h2>
<ul class="list-disc pl-6 text-sm">{{ range .users }}<li><a href="/admin/users/{{ .ID }}" class="underline">{{ .Name }}</a> ({{ .Email }})</li>{{ else }}<li>Nobody yet.</li>{{ end }}</ul>
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::permissions-index" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
{{ template "admin::card-start" . }}<table class="w-full text-left">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">Area</th><th class="px-4 py-2">Key</th><th class="px-4 py-2">Description</th></tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">{{ range .permissions }}<tr data-testid="permission-row"><td class="px-4 py-2">{{ .Group }}</td><td class="px-4 py-2"><code>{{ .Key }}</code></td><td class="px-4 py-2">{{ .Name }}</td></tr>{{ end }}</tbody>
</table>{{ template "admin::card-end" . }}
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::roles-matrix" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
{{ template "admin::card-start" . }}<table class="w-full text-left" data-testid="matrix">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">Permission</th>{{ range .roles }}<th class="px-3 py-2 text-center">{{ .Name }}</th>{{ end }}</tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">{{ $roles := .roles }}{{ $keys := .keys }}
  {{ range $permission := .permissions }}<tr><td class="px-4 py-1.5"><code>{{ $permission.Key }}</code></td>{{ range $roles }}<td class="px-3 py-1.5 text-center">{{ if index (index $keys .Slug) $permission.Key }}<span class="text-emerald-600" data-testid="granted">●</span>{{ else }}<span class="text-slate-300">·</span>{{ end }}</td>{{ end }}</tr>{{ end }}
  </tbody></table>{{ template "admin::card-end" . }}
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::roles-assignments" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
{{ template "admin::card-start" . }}<table class="w-full text-left">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">ID</th><th class="px-4 py-2">Person</th><th class="px-4 py-2">Role</th><th class="px-4 py-2">Direct exceptions</th></tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">{{ $exceptions := .exceptions }}
  {{ range .rows }}<tr data-testid="assignment-row"><td class="px-4 py-2"><a href="/admin/users/{{ .ID }}/edit" class="underline" data-testid="id-link">{{ .ID }}</a></td><td class="px-4 py-2">{{ .Name }} <span class="text-slate-500">{{ .Email }}</span></td><td class="px-4 py-2">{{ .Role }}</td><td class="px-4 py-2">{{ range index $exceptions .ID }}<code class="mr-1">{{ . }}</code>{{ else }}none{{ end }}</td></tr>
  {{ else }}<tr><td colspan="4" class="px-4 py-6 text-center text-slate-500">Nobody has a role yet.</td></tr>{{ end }}
  </tbody></table>{{ template "admin::card-end" . }}
{{ template "admin::footer" . }}{{ end }}

{{ define "admin::roles-links" }}{{ template "admin::header" . }}{{ template "admin::roles-tabs" . }}
{{ if .unmapped }}<div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-200" data-testid="unmapped">No permission (refused to everyone): {{ range .unmapped }}<code class="mr-2">{{ . }}</code>{{ end }}</div>{{ end }}
{{ template "admin::card-start" . }}<table class="w-full text-left">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">Route</th><th class="px-4 py-2">Permission</th></tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">{{ range .routes }}<tr data-testid="link-row"><td class="px-4 py-1.5"><code>{{ index . 0 }}</code></td><td class="px-4 py-1.5"><code>{{ index . 1 }}</code></td></tr>{{ end }}</tbody>
</table>{{ template "admin::card-end" . }}
{{ template "admin::footer" . }}{{ end }}
