{{ define "ai-service::index" }}{{ template "admin::header" . }}
<form method="get" class="mb-4 flex flex-wrap gap-2 text-sm" data-testid="filters">
  <select name="provider" class="rounded border border-slate-300 px-2 py-1.5 dark:border-slate-700 dark:bg-slate-800">{{ $p := .filters.provider }}
    <option value="">All providers</option>{{ range list "anthropic" "openai" "gemini" }}<option value="{{ . }}" {{ if eq . $p }}selected{{ end }}>{{ . }}</option>{{ end }}</select>
  <select name="status" class="rounded border border-slate-300 px-2 py-1.5 dark:border-slate-700 dark:bg-slate-800">{{ $s := .filters.status }}
    <option value="">Any status</option>{{ range list "success" "failed" }}<option value="{{ . }}" {{ if eq . $s }}selected{{ end }}>{{ . }}</option>{{ end }}</select>
  <input name="q" value="{{ .filters.q }}" placeholder="Purpose or model" class="w-56 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-700 dark:bg-slate-800">
  <button class="rounded bg-brand-navy px-3 py-1.5 text-white">Filter</button>
</form>
<p class="mb-3 text-sm text-slate-500" data-testid="spent">Estimated cost, last 30 days: {{ if .hasSpent }}${{ printf "%.4f" .spent }}{{ else }}no prices set (AI_PRICES){{ end }}</p>
{{ template "admin::card-start" . }}
<table class="w-full text-left">
  <thead class="bg-slate-50 text-xs uppercase text-slate-500 dark:bg-slate-800"><tr><th class="px-4 py-2">ID</th><th class="px-4 py-2">When</th><th class="px-4 py-2">Kind</th><th class="px-4 py-2">Provider</th><th class="px-4 py-2">Model</th><th class="px-4 py-2">Purpose</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Tokens in/out</th><th class="px-4 py-2">Time</th><th class="px-4 py-2 text-right">Actions</th></tr></thead>
  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
  {{ range .logs }}
  <tr data-testid="ai-log-row">
    <td class="px-4 py-2"><a href="/admin/ai-api-logs/{{ .ID }}" class="underline" data-testid="id-link">{{ .ID }}</a></td>
    <td class="px-4 py-2 whitespace-nowrap">{{ .CreatedAt }}</td>
    <td class="px-4 py-2">{{ .Kind }}</td><td class="px-4 py-2">{{ .Provider }}</td><td class="px-4 py-2">{{ .ModelName }}</td><td class="px-4 py-2">{{ .Purpose }}</td>
    <td class="px-4 py-2">{{ if eq .Status "failed" }}<span class="text-brand-coral">failed</span>{{ else }}success{{ end }}{{ if .Sensitive }} <span class="text-xs text-slate-500">(sensitive)</span>{{ end }}</td>
    <td class="px-4 py-2">{{ .InputTokens }} / {{ .OutputTokens }}</td><td class="px-4 py-2">{{ .DurationMs }} ms</td>
    <td class="px-4 py-2 text-right"><a href="/admin/ai-api-logs/{{ .ID }}" class="underline">Show</a></td>
  </tr>
  {{ else }}<tr><td colspan="10" class="px-4 py-6 text-center text-slate-500">No AI calls yet.</td></tr>{{ end }}
  </tbody>
</table>
{{ template "admin::card-end" . }}
<p class="mt-3 text-sm text-slate-500">{{ .total }} call(s)</p>
{{ template "admin::footer" . }}{{ end }}

{{ define "ai-service::show" }}{{ template "admin::header" . }}
{{ template "admin::card-start" . }}
<dl class="divide-y divide-slate-200 dark:divide-slate-800">
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">When</dt><dd>{{ .row.CreatedAt }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Kind</dt><dd>{{ .row.Kind }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Provider / model</dt><dd>{{ .row.Provider }} / {{ .row.ModelName }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Purpose</dt><dd data-testid="show-purpose">{{ .row.Purpose }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Status</dt><dd>{{ .row.Status }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Tokens in / out</dt><dd>{{ .row.InputTokens }} / {{ .row.OutputTokens }}</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Duration</dt><dd>{{ .row.DurationMs }} ms</dd></div>
  <div class="flex justify-between px-5 py-3"><dt class="text-slate-500">Estimated cost</dt><dd>{{ if .hasCost }}${{ printf "%.6f" .cost }}{{ else }}no price set{{ end }}</dd></div>
</dl>
{{ template "admin::card-end" . }}
{{ if .row.Sensitive }}<p class="mt-4 text-sm text-slate-500" data-testid="sensitive-note">Sensitive call: the prompt and the reply were not stored.</p>{{ end }}
{{ with .error }}<h2 class="mb-2 mt-6 font-semibold">Error</h2><pre class="overflow-x-auto rounded-xl bg-red-950 p-4 text-xs text-red-100">{{ . }}</pre>{{ end }}
{{ with .prompt }}<h2 class="mb-2 mt-6 font-semibold">Prompt</h2><pre class="whitespace-pre-wrap rounded-xl bg-slate-900 p-4 text-xs text-slate-100" data-testid="prompt">{{ . }}</pre>{{ end }}
{{ with .response }}<h2 class="mb-2 mt-6 font-semibold">Reply</h2><pre class="whitespace-pre-wrap rounded-xl bg-slate-900 p-4 text-xs text-slate-100" data-testid="response">{{ . }}</pre>{{ end }}
{{ if call .can "ai_api_logs.manage" }}
<form method="post" action="/admin/ai-api-logs/{{ .row.ID }}/delete" class="mt-6"><input type="hidden" name="_token" value="{{ .csrf }}">
  <button class="rounded bg-brand-coral px-4 py-2 text-white" data-testid="delete-button">Delete log</button></form>
{{ end }}
{{ template "admin::footer" . }}{{ end }}
