{{ define "auth::forgot-password" }}{{ template "site::header" . }}{{ template "auth::card-start" . }}
<p class="mb-4 text-sm text-slate-600 dark:text-slate-400">{{ t .lang "auth.forgot-intro" }}</p>
<form method="post" action="/forgot-password" class="space-y-4" data-testid="forgot-form">
  <input type="hidden" name="_token" value="{{ .csrf }}">
  <label class="block text-sm">{{ t .lang "auth.email" }}
    <input type="email" name="email" required autofocus class="{{ template "auth::input-class" }}">
  </label>
  <button class="{{ template "auth::button-class" }}" data-testid="forgot-submit">{{ t .lang "auth.forgot-button" }}</button>
</form>
{{ template "auth::card-end" . }}{{ template "site::footer" . }}{{ end }}
