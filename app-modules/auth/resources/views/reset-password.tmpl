{{ define "auth::reset-password" }}{{ template "site::header" . }}{{ template "auth::card-start" . }}
<form method="post" action="/reset-password/{{ .token }}" class="space-y-4" data-testid="reset-form">
  <input type="hidden" name="_token" value="{{ .csrf }}">
  <label class="block text-sm">{{ t .lang "auth.new-password" }}
    <input type="password" name="password" required minlength="8" class="{{ template "auth::input-class" }}">
  </label>
  <label class="block text-sm">{{ t .lang "auth.password-confirmation" }}
    <input type="password" name="password_confirmation" required class="{{ template "auth::input-class" }}">
  </label>
  {{ with .errors.password }}<p class="text-sm text-brand-coral" data-testid="error-password">{{ . }}</p>{{ end }}
  <button class="{{ template "auth::button-class" }}" data-testid="reset-submit">{{ t .lang "auth.reset-button" }}</button>
</form>
{{ template "auth::card-end" . }}{{ template "site::footer" . }}{{ end }}
