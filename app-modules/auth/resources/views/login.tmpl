{{ define "auth::login" }}{{ template "site::header" . }}{{ template "auth::card-start" . }}
<form method="post" action="/login" class="space-y-4" data-testid="login-form">
  <input type="hidden" name="_token" value="{{ .csrf }}">
  <input type="hidden" name="next" value="{{ .next }}">
  <label class="block text-sm">{{ t .lang "auth.email" }}
    <input type="email" name="email" value="{{ .email }}" required autofocus class="{{ template "auth::input-class" }}">
  </label>
  {{ with .errors.email }}<p class="text-sm text-brand-coral" data-testid="error-email">{{ . }}</p>{{ end }}
  <label class="block text-sm">{{ t .lang "auth.password" }}
    <input type="password" name="password" required class="{{ template "auth::input-class" }}">
  </label>
  <button class="{{ template "auth::button-class" }}" data-testid="login-submit">{{ t .lang "auth.login-button" }}</button>
</form>
{{ if .googleSignIn }}
<a href="/auth/google/redirect" class="mt-4 flex w-full items-center justify-center gap-2 rounded border border-slate-300 px-4 py-2 font-semibold hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-800" data-testid="google-sign-in">{{ t .lang "social-auth.continue-with-google" }}</a>
{{ end }}
<div class="mt-4 flex justify-between text-sm">
  <a href="/forgot-password" class="text-brand-navy underline dark:text-brand-amber" data-testid="forgot-link">{{ t .lang "auth.forgot-link" }}</a>
  <a href="/login/email-link" class="text-brand-navy underline dark:text-brand-amber" data-testid="email-link-link">{{ t .lang "auth.email-link-link" }}</a>
  <a href="/register" class="text-brand-navy underline dark:text-brand-amber">{{ t .lang "auth.register-link" }}</a>
</div>
{{ template "auth::card-end" . }}{{ template "site::footer" . }}{{ end }}
